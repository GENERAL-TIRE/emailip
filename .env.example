# Configuración de Correo SMTP para Notificaciones
SMTP_HOST=smtp.ejemplo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tu-usuario-smtp
SMTP_PASS=tu-contraseña-smtp
SMTP_FROM=monitor@tudominio.com

# Correo al que se enviarán las alertas
SUPPORT_EMAIL=soporte@tudominio.com

# (Opcional) Configuración para la actualización de Telefonía
# TELEPHONY_API_KEY=tu-api-key
# TELEPHONY_API_URL=https://api.proveedor-telefonia.com/update
